{
  "name": "climate-change-visualized",
  "private": true,
  "version": "0.1.0",
  "description": "A globe-first climate visualization using a traditional static HTML, CSS, and JavaScript architecture.",
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 4173",
    "build": "node -e \"console.log('No build step required for the static HTML/CSS/JS architecture.')\"",
    "preview": "python -m http.server 4173",
    "generate:logo": "python scripts/generate_logo.py",
    "generate:favicon": "python scripts/generate_logo.py --resize-from docs/branding/climate-change-visualized-logo-dark.png --output assets/favicons/favicon.png --size 512 --corner-radius-ratio 0.085",
    "generate:favicon:option2": "python scripts/generate_favicon_option2.py",
    "generate:favicon:option3": "python scripts/generate_favicon_option3.py",
    "generate:favicon:option4": "python scripts/generate_favicon_option4.py",
    "generate:favicon:option5": "python scripts/generate_favicon_option5.py",
    "generate:data": "python scripts/build_climate_assets.py --monthly-dir data/era5/derived/monthly-single-levels --start-month 1940-01 --end-month 2025-12 --stride 16 --output-dir data",
    "generate:data:demo": "python scripts/build_climate_assets.py --demo --output-dir data",
    "update:roni": "node scripts/update_roni_data.mjs",
    "update:oni": "node scripts/update_roni_data.mjs",
    "check:era5": "python scripts/check_era5_setup.py",
    "download:era5:raw": "python scripts/download_era5_cds.py --mode raw-hourly --output-root data/era5",
    "download:era5:monthly": "python scripts/download_era5_cds.py --mode monthly-means --output-root data/era5"
  },
  "dependencies": {
    "h3-js": "^4.4.0",
    "maplibre-gl": "^5.6.2"
  },
  "devDependencies": {
    "vite": "^7.1.11"
  }
}
