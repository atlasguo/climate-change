{
  "name": "climate-change",
  "private": true,
  "version": "0.2.0",
  "description": "A globe-first climate visualization built as a static HTML, CSS and JavaScript site.",
  "author": "Atlas Guo",
  "type": "module",
  "scripts": {
    "dev": "python -m http.server 4173",
    "serve": "python -m http.server 4173",
    "generate:favicon": "python scripts/generate_favicon.py",
    "generate:logo": "python scripts/generate_favicon.py --transparent --size 128 --output assets/branding/logo-ring.png",
    "generate:data": "python scripts/build_climate_assets.py --monthly-dir data/era5/derived/monthly-single-levels --stride 8 --output-dir data",
    "generate:data:demo": "python scripts/build_climate_assets.py --demo --output-dir data",
    "update:roni": "node scripts/update_roni_data.mjs",
    "check:era5": "python scripts/check_era5_setup.py",
    "download:era5:monthly": "python scripts/download_era5_cds.py --mode monthly-means --bundle year --start 1940-01 --end 2025-12 --output-root data/era5",
    "download:era5:raw": "python scripts/download_era5_cds.py --mode raw-hourly --start 1940-01 --end 2025-12 --output-root data/era5"
  }
}
